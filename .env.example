# tunarr-mcp configuration
#
# Copy to `.env` (or set these in your compose file / shell) and adjust.
# All values are read by src/config.ts via loadConfig(); invalid values fail
# fast at startup with an actionable ConfigError on stderr (exit code 1).

# REQUIRED — ROOT URL of the Tunarr server (no /api suffix; the MCP client
# appends /api/... paths itself). Trailing slash is OK.
# Examples:
#   Tunarr on another container/host:  http://tunarr:8409
#   Tunarr on this machine:            http://127.0.0.1:8409
TUNARR_URL=http://tunarr:8409

# Optional — API key sent to Tunarr as `Authorization: Bearer <key>`.
# Tunarr's API currently needs no auth, so leave this unset unless yours
# requires a key.
#TUNARR_API_KEY=

# Optional — TCP port for the MCP Streamable HTTP server (integer 1-65535).
PORT=3001

# Optional — bind address for the HTTP server. Keep 0.0.0.0 in Docker;
# use 127.0.0.1 to expose only to localhost on a bare host.
HOST=0.0.0.0

# Backward compatibility: TUNARR_BASE_URL is still accepted as a fallback
# when TUNARR_URL is unset, but new setups should use TUNARR_URL.
#TUNARR_BASE_URL=
