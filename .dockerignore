# Keep the build context minimal: only package.json, pnpm-lock.yaml,
# pnpm-workspace.yaml, tsconfig.json, and src/ are needed in the image.

# Dependency/store artifacts
node_modules
.pnpm-store

# Version control
.git
.gitignore

# Build output (rebuilt inside the image)
dist

# Tests and docs (not shipped in the image)
tests
plans
README.md

# Local dev scratch files
tmp-*
tmp-getchannel.mjs
mcp-config.json
.vitest*

# Secrets / env files
.env
.env.*
!.env.example

# Docker files themselves (not needed in the build context)
Dockerfile
.dockerignore
docker-compose.yml
